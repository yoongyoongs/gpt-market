# Empty disables auth for local testing. Always set a long random value in production.
MCP_TOKEN=change_me_to_a_long_random_secret
# Protects /gpt/{secret}/...; if empty, MCP_TOKEN is reused.
GPT_WEB_SECRET=change_me_to_another_long_random_secret
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
# 部署时可绑定到明确 Git Commit 镜像，便于应用与 Worker 同步升级和回滚。
APP_IMAGE=gpt-market:latest
EASTMONEY_TIMEOUT=5
EASTMONEY_RETRIES=3
# Optional. Leave empty on a normal Linux server; useful only where outbound HTTPS requires a proxy.
EASTMONEY_PROXY=
TENCENT_TIMEOUT=5
TENCENT_PROXY=
SCAN_CONCURRENCY=12
MAX_KLINE_CONCURRENCY=8
KLINE_CACHE_PATH=/data/kline_cache.sqlite3
KLINE_REFRESH_TRADING_SECONDS=300
KLINE_REFRESH_CLOSED_SECONDS=1800

# V3 is opt-in until its Phase acceptance is complete. Legacy V1/V2 does not
# connect to PostgreSQL while this is false.
V3_ENABLED=false
V3_DATABASE_URL=postgresql+asyncpg://gpt_market:change_me_v3@postgres:5432/gpt_market
V3_DATABASE_ECHO=false
V3_DATABASE_POOL_SIZE=5
V3_DATABASE_MAX_OVERFLOW=5
# V3 市场 READ 默认公开；Portfolio READ 和所有 WRITE 必须使用 Bearer。
# 未设置 V3_API_TOKEN 时兼容复用 MCP_TOKEN。
V3_API_TOKEN=change_me_to_a_separate_v3_secret
V3_API_PRINCIPAL_ID=v3-operator
V3_PUBLIC_MARKET_READ=true
# Strategy Activate/Rollback 只接受独立管理员 Token，不回退到普通 V3 Token。
V3_STRATEGY_ADMIN_TOKEN=change_me_to_a_separate_strategy_admin_secret
V3_STRATEGY_ADMIN_PRINCIPAL_ID=v3-strategy-admin
V3_PHASE2_SCHEDULE_AT=18:30
V3_PHASE2_LOCK_KEY=33020001
V3_PHASE2_REPORT_PATH=/tmp/v3-phase2-last.json
V3_PHASE2_CONCURRENCY=16
V3_PHASE2_HISTORY_LIMIT=300
POSTGRES_DB=gpt_market
POSTGRES_USER=gpt_market
POSTGRES_PASSWORD=change_me_v3
